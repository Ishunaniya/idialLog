#include <windows.h>
#include "version.h"       /* 版本号单一来源:改版本只改 version.h */

/* 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 = RT_MANIFEST
   嵌入清单以启用 comctl32 v6(现代控件外观)与 DPI 感知 */
1 24 "app.manifest"

/* 应用图标:数字最小的 ICON 资源即 exe 在资源管理器/任务栏显示的图标。
   IDI_APPICON=101,与 ui.cpp 的 LoadIconW 对应。图标为多尺寸(16..256)。 */
101 ICON "dialLog.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     DL_VER_MAJOR,DL_VER_MINOR,DL_VER_PATCH,0
PRODUCTVERSION  DL_VER_MAJOR,DL_VER_MINOR,DL_VER_PATCH,0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"   /* 中文(简体) / Unicode */
        BEGIN
            VALUE "FileDescription", "拨号日志分析工具(modem_mng / open_dial / artery)"
            VALUE "FileVersion",     DL_VER_STR4
            VALUE "InternalName",    DL_APP_NAME
            VALUE "OriginalFilename",DL_EXE_NAME
            VALUE "ProductName",     DL_APP_NAME
            VALUE "ProductVersion",  DL_VER_STR4
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
